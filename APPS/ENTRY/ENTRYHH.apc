    HH3 = xintnum;
    HH4 = xsupnum;
  endif;
PROC HH5D
preproc
   if visualvalue(HH5D)=notappl then
		if !sysdate("YYYYMMDD") in minvalue(HH5Y_VST)*10000+0101:maxvalue(HH5Y_VST)*10000+1231 then // !!personalizar com as datas do trabalho de campo
			errmsg(9988,minvalue(HH5Y_VST),maxvalue(HH5Y_VST));
			stop(-1);
		endif;   
		HH5D = sysdate( "DD" );
		HH5M = sysdate( "MM" );
		HH5Y = sysdate( "YYYY" );
	endif;

PROC HH5Y
di = cmcode(HH5M,HH5Y);

