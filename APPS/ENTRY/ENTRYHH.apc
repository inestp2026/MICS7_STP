	ensureNotBlank(other);
endif;

if $ in 18,21,22,23,24,31,32,99 then
	skip to WS11DA
elseif $ in 11,14,41,51,96 then
	skip to WS14
elseif $ = 95 then
	endgroup;
endif;


PROC WS11B
if $ <> 1 then
	skip to WS11DA;
endif;	
