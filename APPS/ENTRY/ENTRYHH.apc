	alpha(26) alphanew;                { Variável alfa de trabalho usada na verificação de variáveis alfa }
	alpha(62) alphalst;                { O alfabeto }

	array codes(50);                   { Array usado para criar os números de linha dos membros do agregado que dormem sob a rede mosquiteira}
	array alpha(50) labels(50);        { Array usado para criar os nomes dos membros do agregado que dormem sob a rede mosquiteira} 

