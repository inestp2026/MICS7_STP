PROC FORMHH
preproc
if visualvalue (HHHHTSTMPS) = notappl then
   HHHHTSTMPS = timestamp (); 
   endif; 
   
  if visualvalue(HH46)=1 then  //se o questionário estiver concluído, não é permitida a gravação parcial
     noPartFlag=1;
  else
	 noPartFlag=0;
  endif;

	//Avança para o questionário da qualidade da água
  if xentryhw then
		advance to WQ1;
  endif;

postproc
if visualvalue (HHHHTSTMPE) = notappl then
   HHHHTSTMPE = timestamp (); 
   endif; 
PROC HH1
postproc
  CLUSTER_SEL = $;
  if loadcase( CLUSTERS, cluster_sel ) then
    HH6 = zone;
    HH7 = REGION;
  endif;


PROC HH2
postproc
	set attributes(HHNAME) native;
	if addmode then
		HHNAME = sysparm("HEAD");
	else
		if length(strip(HHNAME)) then 
			set attributes (HHNAME) protect; 
		else 
			HHNAME = sysparm("HEAD");
		endif;
	endif;

PROC HH4
preproc;
