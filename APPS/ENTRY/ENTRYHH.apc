   HHHWTSTMPS = timestamp (); 
   endif; 

postproc
if visualvalue(HHHWTSTMPE) = notappl then
   HHHWTSTMPE = timestamp (); 
   endif; 
PROC HW1
preproc
	if addmode then
		savepartial();
	endif;

postproc
	{ Mostra a caixa de notas para registar a resposta "Outro" }
	if $ = 6 and !inadvance() then
		string other = editnote();
		ensureNotBlank(other);
	endif;
  
	if $ >= 4 then
		skip to HW4A
	endif;  

PROC HW3
alphavar = $;
if alphachk("ABCDY") then
	errmsg(9998);
	reenter
else
	$ = alphavar;
endif;
{ Verifica se "Nenhum destes presente" é a única resposta }
if pos("Y",$) & alphsize > 1 then
	errmsg(9995);
	reenter
endif;
PROC HW4A
