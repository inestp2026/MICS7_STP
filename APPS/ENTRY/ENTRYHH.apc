{ Mostra a caixa de notas para registar a resposta "Outro" }
if pos("X",$) and !inadvance() then
	string other = editnote();
	ensureNotBlank(other);
endif;

PROC HC8B
if $ < 98 then
   if $=11 and HC8AA<>"A" or
      $=21 and HC8AB<>"B" or
      $=31 and HC8AC<>"C" or
      $=32 and HC8AD<>"D" or
      $=41 and HC8AE<>"E" or
      $=51 and HC8AF<>"F" or
      $=52 and HC8AG<>"G" or 
      $=96 and HC8AX<>"X" then
      errmsg("Só pode registar aqui uma fonte que tenha sido registada em HC8A. Por favor verifique");
	  reenter;
   endif;	  
endif;

if $ = 96 and !inadvance() then
	string other = editnote();
	ensureNotBlank(other);
endif;

PROC HC12
