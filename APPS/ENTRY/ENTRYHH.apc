PROC TN1
preproc
	if addmode then
		savepartial();
	endif;
	
postproc
if TN1 <> 1 then
	endgroup;
endif;

PROC TNLN
preproc
	if curocc(FORMTN_ROSTER) > TN2 then
		endgroup
	endif;

	if inEntry then
		do i = 1 while i <= maxnet
			if i <= TN2 then
				TNLN(i) = i;
			else
				TNLN(i) = notappl;
			endif;
		enddo;
	endif;

  
PROC TN5
{ Mostra a caixa de notas para registar a resposta "Outro" }
