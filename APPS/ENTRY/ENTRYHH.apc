	{ Funções definidas pelo utilizador }

	{ função de ajuda para mostrar a lista dos membros do agregado }
	function showroster () 
		show( MICS7HH.MODHL, HL1, HL2, HL3, HL4, HL6  title( tr("NL"), tr("Nome"), tr("Parentesco"), tr("Sexo"), tr("Idade") ) );
	end;

	function showCalc()
		execsystem("calc");
	end;

	function ensureNotBlank(string value, numeric min_length = 1)	
		if length(strip(value)) < min_length then
			errmsg ("Deve introduzir um texto com %d+ caracteres no campo %s", min_length, getsymbol());
			reenter;
		endif;
	end;
	
	function showmanuals ()
		view(publicfolder+"\interviewer_manual.pdf");
    end;
	  
	function goto()
		selection = accept(tr("Ir para a secção"),
						   tr("Painel de Informação do Agregado"),
						   tr("Lista dos Membros do Agregado - Inicial"),
						   tr("Lista dos Membros do Agregado"),
						   tr("Educação"),
						   tr("Características do Agregado"),
					       tr("Uso de Energia no Agregado"),
						   tr("Redes Mosquiteiras Tratadas com Inseticida"),
						   tr("Transferências Sociais"),
						   tr("Pós-Emergência"),
						   tr("Experiência de Insegurança Alimentar"),
						   tr("Água"),
						   tr("Saneamento"),
						   tr("Higiene"),
						   tr("Fim da Entrevista"),
						   tr("Teste da Qualidade da Água"));
		
		if selection = 1 then
			move to FORMHH advance;
		elseif selection = 2 then
			move to FORMHX advance;
		elseif selection = 3 then
			move to FORMHL advance;
		elseif selection = 4 then
			move to FORMED advance;
		elseif selection = 5 then
			move to FORMHC advance;
		elseif selection = 6 then
			move to FORMEU advance;
		elseif selection = 7 then    
			move to FORMTN advance;
		elseif selection = 8 then    
			move to FORMST advance;
		elseif selection = 9 then
			//move to FORMPE advance;
		elseif selection = 10 then
			//move to FORMFE advance;
		elseif selection = 11 then
			move to FORMWS advance;	  
		elseif selection = 12 then
			move to FORMWS2 advance;	  
		elseif selection = 13 then
			move to FORMHW advance;
	    elseif selection = 14 then
			move to FORMEND advance;
	    elseif selection = 15 then
			move to FORMWQ advance;
		endif;
	end;
	  
	{ configura a barra de utilizador básica }
	function userbase();
		userbar( clear );
		userbar( add button, "<",    do("PreviousField") );
		userbar( add button, ">",    do("NextField") );
		userbar( add button, ">>|",  do("AdvanceToEnd") );
		userbar( add button, tr("Nota"), do("EditNote") );
		userbar( add button, tr("Idioma"), do("ChangeLanguage") );
		userbar( add button, tr("Calc"), showCalc );
		userbar( add button, tr("Secção"), goto );
		userbar(add button, tr("Manuais"),  showManuals );;
		userbar( add spacing, 10 );  
		userbar( add button, tr("Ver lista do agregado"), showroster() );
	end;
  
	{ valid
	Verifica se uma variável tem um valor válido.
	Um valor válido é inferior a 96 e não é um valor especial, p.ex. notappl/missing
	Devolve: 1 se válido, 0 se não válido                                        }
	function valid(xvar);
		valid = (!special(xvar) and xvar < 96)
	end;

	{ clear_labels
	Define as etiquetas de valores das perguntas cujas categorias de resposta podem mudar }
	function clean_labels();
		do i = 1 while i <= 50 by 1
			codes(i) = notappl;
			labels(i) = "";
		enddo;
	end;

	{ Funções MTILD (redes mosquiteiras) }
	function setnet(alpha(8) xvarname, curnet);
		clean_labels();
		n = tonumber(xvarname[length(strip(xvarname)):1]);  { Obtém o número de TN15_x, p.ex. TN15_2 devolve 2 }
		x = 0;
		codes(x) = 0;
		labels(x) = tr("Não está na lista do agregado");
			
		for i in FORMHL_ROSTER do
			found = 0;
			do net = 1 while !found & net <= curnet
				if !found & (net < curnet | n > 1) & TN15_1(net) = i then found = 1 endif;
				if !found & (net < curnet | n > 2) & TN15_2(net) = i then found = 1 endif;
				if !found & (net < curnet | n > 3) & TN15_3(net) = i then found = 1 endif;
				if !found & (net < curnet        ) & TN15_4(net) = i then found = 1 endif;
			enddo;
			if !found then
				x = x + 1;
				codes(x) = i;
				labels(x) = HX2(i);
			endif;
		enddo;
		if n <> 1 then { Primeira pessoa - não pode ser "90" }
			x = x + 1;
			codes(x) = 90;
			labels(x) = tr("Mais ninguém");
		endif;
	end;

	function checknet(xvar, alpha(8) xvarname, curnet);
		e = 0;
		n = tonumber(xvarname[length(strip(xvarname)):1]);  { Obtém o número de TN15_x, p.ex. TN15_2 devolve 2 }
		if xvar = 90 then
			if n = 1 & TN10 = 1 then
				e=errmsg(0205);
			endif;
		elseif xvar < 90 then
			if xvar > HH48 then	{ Superior ao número de membros do agregado }
				e=errmsg(0201,xvar,HH48);
			else
				{ O membro já está listado, possivelmente sob outra rede? }
				found = 0;
				if xvar <> 0 then
					do net = 1 while !found & net <= curnet
						if !found & (net < curnet | n < 1) & TN15_1(net) = xvar then found = 1 endif;
						if !found & (net < curnet | n < 2) & TN15_2(net) = xvar then found = 1 endif;
						if !found & (net < curnet | n < 3) & TN15_3(net) = xvar then found = 1 endif;
						if !found & (net < curnet | n < 4) & TN15_4(net) = xvar then found = 1 endif;
					enddo;
				endif;
				if found then
					e=errmsg(0204,xvar);
				endif;
				{ verifica se a pessoa dormiu no agregado na noite passada }
				if xvar <> 0 then
					if HL7(xvar) <> 1 then
						e=errmsg(0203,xvar,HL7(xvar));
					endif;
				endif;
			endif;
		endif;
		checknet = e;
	end;

	{ endmess
	Se o utilizador estiver em addmode, mostra um menu com as opções
	"Rever Questionário" e "Questionário Seguinte"
	Devolve: 1 se o utilizador estiver em addmode ou selecionar Questionário Seguinte, 0 caso contrário }
	function endmess();
		{ Devolve verdadeiro se a resposta for REVER }
		endmess = (accept(tr("Fim do Questionário"),
						  tr("Verificar Questionário"),
						  tr("Novo quest./Questionário seguinte")) <> 2);
	end;

	{ Função para verificar a introdução de variáveis alfa }
	{ alphachk
	Função para verificar a introdução de variáveis alfa.
    Requisito: preceder com a instrução alphavar = $
    Variáveis de entrada:
    alphamask - Os caracteres permitidos, a sua ordem e posição
    alphavar (definida antes de chamar a função) - a variável a verificar

    Verifica se todos os caracteres da variável alphavar existem em alphamask
    e se estão na ordem correta. Reposiciona os caracteres antes de devolver.
    Se encontrar ? na cadeia, garante que não existem outros caracteres
    Devolve: a cadeia reposicionada se válida, caso contrário 0

    Exemplos:
    alphavar    alphamask     devolve
    "ABC"		  "ABCDEX"      "ABC   "
    "AC"		  "ABCDEX"      "A C   "
    "BEX"		  "ABCDEX"      " B  EX"
    "?"		  "ABCDEX"      "??????"
    "J"		  "ABCDEX"      0
     "ABQ"		  "ABCDEX"      0
    "?A"		  "ABCDEX"      0
    "BA"		  "ABCDEX"      0 (ordem errada)                 }
	function alphachk(alpha(26) alphamask);
		{  russian_convert();}
		{ primeiro remove todos os espaços e os pontos de interrogação duplicados }
		alphanew = "";
		qmark = 0;
		lx = 1;
		do l = 1 while l <= length(strip(alphavar))
			if alphavar[l:1] <> " " and (alphavar[l:1] <> "?" or not qmark) then
				alphanew[lx:1] = alphavar[l:1];
				lx = lx + 1;
				if alphavar[l:1] = "?" then
					qmark = 1;
				endif;
			endif;
		enddo;
		{ aok = 0 - cadeia inválida, aok = 1 - cadeia válida }
		totlen = length(strip(alphamask));
		aok = 0;           { assume que a cadeia é inválida - para cadeia vazia }
		alphsize = length(strip(alphanew));
		if alphsize then   { cadeia não vazia }
			{ verifica se "?" é o único carácter }
			aok = (alphanew[1:1] = "?" and alphsize = 1);
			if !aok then     { se não for um único "?", verifica a cadeia }
				aok = 1;       { agora assume que a cadeia é válida até prova em contrário }
				l = 1;         { l é a posição na cadeia de valores aceitáveis }
				a = 1;         { a é a posição na cadeia de entrada }
				{ ciclo enquanto a cadeia for válida e houver mais letras }
				while aok and a <= alphsize do
					aok = pos(alphanew[a:1],alphamask[l:totlen-l+1]);
					if aok then     { a letra é aceitável }
						l = l + aok;  { incrementa l para a posição a seguir à letra na cadeia de valores aceitáveis }
						a = a + 1     { incrementa a para a letra seguinte da cadeia de entrada }
					endif;
				enddo;
			endif;
		endif;
		alphachk = (!aok);    { alphachk = 0 - se a cadeia for válida, = 1 - se for inválida }
		{ agora expande as variáveis }
		if aok then
			do l = 1 while l <= length(strip(alphamask))
				if pos(alphamask[l:1],alphanew) then
					alphavar[l:1] = alphamask[l:1]
				elseif pos("?",alphanew) then
					alphavar[l:1] = "?"
				else
					alphavar[l:1] = " "
				endif;
			enddo;
		endif;
	end;

	function onStop();
		if noPartFlag | xmodcent then
			x1 = errmsg(9980) select(tr("Sim"), continue, tr("Não"), continue);
			if x1 = 1 then
				advance;
			else
				if !xmodcent then
					stop(-1);
				endif;
			endif;
		else
			savepartial();
			stop(-1);
		endif;
	end;

	function setEDlabels(edlevel);
		valueset educgrades;
		if edlevel = 1 then         //primário
		   educgrades.add(tr("CLASSE/ANO") + " 1",1);
		   educgrades.add(tr("CLASSE/ANO") + " 2",2);
		   educgrades.add(tr("CLASSE/ANO") + " 3",3);
		   educgrades.add(tr("CLASSE/ANO") + " 4",4);
		   educgrades.add(tr("CLASSE/ANO") + " 5",5);
		   educgrades.add(tr("CLASSE/ANO") + " 6",6);
		elseif edlevel = 2 then      //secundário inferior
		   educgrades.add(tr("CLASSE/ANO") + " 1",1);
		   educgrades.add(tr("CLASSE/ANO") + " 2",2);
		   educgrades.add(tr("CLASSE/ANO") + " 3",3);
		elseif edlevel = 3 then      //secundário superior
		   educgrades.add(tr("CLASSE/ANO") + " 1",1);
		   educgrades.add(tr("CLASSE/ANO") + " 2",2);
		   educgrades.add(tr("CLASSE/ANO") + " 3",3);
		elseif edlevel in 4,8,9 then      //superior
		   educgrades.add(tr("CLASSE/ANO") + " 1",1);
		   educgrades.add(tr("CLASSE/ANO") + " 2",2);
		   educgrades.add(tr("CLASSE/ANO") + " 3",3);
		   educgrades.add(tr("CLASSE/ANO") + " 4",4);
		   educgrades.add(tr("CLASSE/ANO") + " 5",5);
		   educgrades.add(tr("CLASSE/ANO") + " 6",6);
		   educgrades.add(tr("CLASSE/ANO") + " 7",7);	   
		   educgrades.add(tr("CLASSE/ANO") + " 8",8);
		endif;
		   educgrades.add(tr("NS"),98);	   
		   educgrades.add(tr("SEM RESPOSTA"),99);	
		setvalueset(@getsymbol(),educgrades);
	end

	function string htmlencode (string htmltext);
		htmltext=replace(htmltext,"&","+");
		htmltext=replace(htmltext,"'","-");
		htmltext=replace(htmltext,'"',"/");
		htmltext=replace(htmltext,"<","[");
		htmltext=replace(htmltext,">","]");
		
		htmlencode=htmltext;
	end;

	array string daystr(7);
	string daystring, daystring3;

	function dayOfWeek(yyyymmdd)
		numeric referenceDay = 20230813; // Este dia foi um domingo
		numeric diff = datediff(referenceDay, yyyymmdd, "d");
		dayOfWeek = diff % 7 + 1;
	end;


PROC FL_ENTRYHH
preproc
  
	setfont(All,"Consolas",30);
	//setproperty(MICS7HH,"uppercase",yes);
  
	setlanguage("ENG");  
	//setlanguage("FRA");  // para definir a língua francesa
	//setlanguage("ARB");  // para definir a língua árabe
	//setlanguage("SPA");  // para definir a língua espanhola
	//setlanguage("RUS");  // para definir a língua russa
	//setlanguage("CS");  // para definir a língua específica do país

	verific = 0;
	maxmem = 50;      { número máximo de membros do agregado }
	maxnet = 10;      { número máximo de redes mosquiteiras. DEVE SER IGUAL OU INFERIOR AO MAX OCCUR DE MODTN }
	minage = 15;      { idade mínima das mulheres elegíveis }
	maxage = 49;      { idade máxima das mulheres elegíveis }
	mminage = 15;     { idade mínima dos homens elegíveis }
	mmaxage = 49;     { idade máxima dos homens elegíveis }
	minab  = 120;     { idade mínima ao ter um filho, em meses = 12 anos }
	addmode = (demode() = ADD);

  xintnum = tonumber(sysparm("INTERVIEWERID"));
  xsupnum = tonumber(sysparm("SUPERID"));
  xmodcent = tonumber(sysparm("MODCENTRAL"));
  xentryhw = tonumber(sysparm("ENTRYWQ"));

	alphalst = "ABCDEFGHIJKLMNOPQRSTUVWXYZÃÇÅÄÁÆÈÊËÌÍÎÏÐÑÒÓÔÕÖØÙÚÛÝÞßáãäåæíÉìÂ";
	inEntry = (demode() = add | demode() = modify);

  xverif = tonumber(sysparm("VERIFY"));

	{ configurações para CAPI }
	if !xmodcent then      { o escritório central não tem de sair depois de rever um agregado }
		set behavior() exit on;
	else
		set behavior() exit off;
		addmode = 0;
		noPartFlag = 1;
	endif;

    setproperty(MICS7HH, "ShowExtendedControlTitle", "No");

	{ configura a barra de utilizador mínima }
	userbase();
	userbar( show );

	//prepara os valuesets para HL3 (parentesco com o chefe do agregado)
	headrelationship.clear();
	headrelationship.add(getlabel(HX3,1),1);//cria o valueset para o chefe
	otherrelationship=HX3_VST;              //cria o valueset para os restantes
	otherrelationship.remove(1);

    daystr(1)="Domingo";
    daystr(2)="Segunda-feira";
	daystr(3)="Terça-feira";
	daystr(4)="Quarta-feira";
	daystr(5)="Quinta-feira";
	daystr(6)="Sexta-feira";
	daystr(7)="Sábado";
	daystring=daystr(dayOfWeek(sysdate("YYYYMMDD"))); 
	daystring3=daystr(dayOfWeek(dateadd(sysdate("YYYYMMDD"),-3,"d"))); 


	
setfile(STAFF_DICT,publicfolder+"\staff.csdb");

postproc
	if !xmodcent then      { o escritório central não tem de sair depois de rever um agregado }
		stop(-1);
	endif;

PROC HH
preproc
	qhmoreCount = totocc(FORMHX_Roster); 
