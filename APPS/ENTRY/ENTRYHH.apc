	string other = editnote();
	ensureNotBlank(other);
endif;
PROC TN13
if $ = 1 then
	skip to TN15_1;
elseif $ in 8,9 then
	skip to next TNLN
endif;


PROC TN14A
skip to next TNLN;
PROC TN15_1
onfocus
	setnet(GetSymbol(),curocc());
	setvalueset($,codes,labels);

postproc
	if checknet($,GetSymbol(),curocc()) then
		reenter
	elseif $ > HH48 then
		errmsg( 0201, $,HH48 );
		reenter;
	endif;


PROC TN15_2
onfocus
	setnet(GetSymbol(),curocc());
	setvalueset($,codes,labels);


postproc
	if checknet($,GetSymbol(),curocc()) then
		reenter
	elseif $ = 90 then
		skip to next TNLN
	elseif $ > HH48 then
		errmsg( 0201, $,HH48 );
		reenter;
	elseif $ & $ = TN15_1 then
		errmsg( 0202);
		reenter;
	endif;
	
PROC TN15_3
