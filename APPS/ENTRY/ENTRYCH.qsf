        questionText:
          ENG: |
            <p><span class="Itxt">BCG: dia</span></p>
            <p><span class="Itxt">Copie as datas de cada vacina a partir dos documentos.</span></p>
            <p><span class="Itxt">Registe '00' na coluna do dia se a vacina não foi administrada.</span></p>
            <p><span class="Itxt">Registe '44' na coluna do dia se os documentos mostrarem que a vacina foi administrada mas sem data registada.</span></p>
