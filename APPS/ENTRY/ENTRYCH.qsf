    conditions:
      - questionText:
          ENG: |
            <p><span class="Qnum">EC25. </span><span class="Qtxt">Em comparação com crianças da mesma idade, com que intensidade <span class="REF">~~UF3N~~</span> dá pontapés, morde ou bate noutras crianças ou adultos?</span></p><p></p>
            <span class="Qtxt">Diria: nada, menos, o mesmo, mais ou muito mais?</span><p></p>
